// Prisma Schema — Plataforma Matriz (PoC / MVP)
// Base de dados relacional SQLite com suporte a migrações e integridade referencial

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Utilizadores e Perfis (RBAC)
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  role         String   @default("TEAM_MEMBER") // "PROJECT_MANAGER" | "TEAM_MEMBER"
  passwordHash String   @default("")
  createdAt    DateTime @default(now())

  // Relacionamentos
  managedProjects Project[]        @relation("ProjectManager")
  assignedTasks   Task[]           @relation("TaskAssignee")
  taskAssignments TaskAssignment[] @relation("UserTaskAssignments")
  comments        Comment[]        @relation("UserComments")

  @@map("users")
}

// 2. Projetos da Organização
model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  targetDate  DateTime
  status      String   @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "ON_HOLD"
  managerId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  manager User   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  tasks   Task[]

  @@map("projects")
}

// 3. Tarefas e Fluxo Kanban
model Task {
  id          String   @id @default(uuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?
  priority    String   @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  status      String   @default("TODO")   // "TODO" | "IN_PROGRESS" | "DONE"
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos com Integridade Referencial
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignments TaskAssignment[]
  comments    Comment[]

  @@map("tasks")
}

// 4. Comentários em Tarefas (Extensibilidade e Rastreabilidade)
model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("UserComments", fields: [authorId], references: [id], onDelete: Restrict)

  @@map("comments")
}

// 5. Atribuições de Múltiplos Responsáveis a Tarefas (N:M com Prevenção de Duplicados)
model TaskAssignment {
  id         String   @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  // Integridade Relacional: Cascade se a tarefa ou utilizador for removido
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("UserTaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}
